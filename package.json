{
  "name": "streetconnect",
  "version": "1.0.0",
  "private": true,
  "description": "StreetConnect - Dog Welfare & Community App",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npx expo start",
    "dev:docker": "docker-compose up -d",
    "dev:docker:logs": "docker-compose logs -f",
    "stop:docker": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

# Server Configuration
NODE_ENV=development
PORT=8000
API_VERSION=v1

# Database (Docker Postgres on 5433: docker-compose up -d postgres)
DATABASE_URL=postgres://streetconnect:streetconnect_secure_password@localhost:5433/streetconnect_db
DB_HOST=localhost
DB_PORT=5433
DB_NAME=streetconnect_db
DB_USER=streetconnect
DB_PASSWORD=streetconnect_secure_password
DB_POOL_MAX=20
DB_POOL_MIN=5

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=streetconnect-uploads
AWS_S3_URL=https://streetconnect-uploads.s3.amazonaws.com

# Pusher
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap2

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:8081,exp://localhost:8081

# Logging
LOG_LEVEL=debug

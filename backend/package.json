{
  "name": "streetconnect-backend",
  "version": "1.0.0",
  "description": "StreetConnect Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "fix-port": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true; echo 'Port 3000 freed. Run: npm run dev'",
    "build": "tsc",
    "start": "node dist/server.js",
    "setup": "ts-node src/scripts/setup-supabase.ts",
    "init-db": "ts-node src/scripts/init-db-api.ts",
    "create-tables": "ts-node src/scripts/create-tables.ts",
    "migrate:supabase": "ts-node src/scripts/run-migration.ts",
    "migrate:api": "ts-node src/scripts/run-migration-api.ts",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "ts-node src/scripts/seed.ts",
    "seed-location": "ts-node src/scripts/seed-location-based.ts",
    "reset-seed": "ts-node src/scripts/reset-and-seed.ts",
    "move-to-delhi": "ts-node src/scripts/move-dogs-to-delhi.ts",
    "update-coords": "ts-node src/scripts/update-coords-sql.ts",
    "show-db": "ts-node src/scripts/show-db.ts",
    "check-buckets": "ts-node src/scripts/check-buckets.ts",
    "check-schema": "ts-node src/scripts/check-schema.ts",
    "complete-setup": "ts-node src/scripts/complete-setup.ts",
    "seed:old": "sequelize-cli db:seed:all",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "aws-sdk": "^2.1529.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.14.0",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "pusher": "^5.2.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.12",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.3",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

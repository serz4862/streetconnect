{
  "name": "streetconnect-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node -e \"var fs=require('fs'),path=require('path');var n=path.join(process.cwd(),'node_modules');var l=path.join(n,'react-native-worklets');var t=path.join(n,'react-native-worklets-core');if(!fs.existsSync(l)&&fs.existsSync(t)){try{fs.symlinkSync('react-native-worklets-core',l);console.log('Created react-native-worklets symlink for Reanimated');}catch(e){console.warn('Symlink skipped:',e.message);}}\"",
    "prestart": "node -e \"var fs=require('fs'),path=require('path');var n=path.join(process.cwd(),'node_modules');var l=path.join(n,'react-native-worklets');var t=path.join(n,'react-native-worklets-core');if(!fs.existsSync(l)&&fs.existsSync(t)){try{fs.symlinkSync('react-native-worklets-core',l);}catch(e){}}\"",
    "start": "CI=false EXPO_PUBLIC_API_URL=http://192.168.1.2:3000/api/v1 REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.2 expo start",
    "start:clear": "CI=false EXPO_PUBLIC_API_URL=http://192.168.1.2:3000/api/v1 REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.2 expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.9",
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.6.5",
    "date-fns": "^3.0.6",
    "expo": "^54.0.33",
    "expo-barcode-scanner": "~12.9.3",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "^8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^10.7.2",
    "pusher-js": "^8.4.0-rc2",
    "react": "19.1.0",
    "react-hook-form": "^7.49.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-mmkv": "^2.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets-core": "^1.6.2",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/plugin-transform-computed-properties": "^7.28.6",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.28.6",
    "@babel/plugin-transform-optional-chaining": "^7.28.6",
    "@babel/plugin-transform-shorthand-properties": "^7.27.1",
    "@babel/plugin-transform-template-literals": "^7.27.1",
    "@types/react": "~19.1.10",
    "@types/react-native": "~0.73.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.56.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "private": true
}
